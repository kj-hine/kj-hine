# Function to retrieve peak flow data for the year 1950
get_peak_flow_2020 <- function(siteNumber) {
  # Retrieve peak flow data
  peak_data <- tryCatch(
    readNWISpeak(siteNumber),
    error = function(e) NULL
  )
  
  if (is.null(peak_data)) {
    return(data.frame(site_no = siteNumber, peak_dt = NA, peak_va = NA))
  }
